# --- Client (baked into the build by Vite; put these in .env.production.local) ---
# From Firebase console > Project settings > Your apps > Web app config. These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
# The Cloud Run URL of the game server (leave empty when the server also serves the client)
VITE_GAME_SERVER_URL=https://infinite-rts-server-xxxxxxxx-uc.a.run.app

# --- Server (set on the Cloud Run service) ---
# Required in production: ID tokens are verified against this project, and the world is stored in its Firestore
FIREBASE_PROJECT_ID=your-project-id
# Origins allowed to open a socket (comma-separated)
ALLOWED_ORIGINS=https://your-project-id.web.app,https://your-project-id.firebaseapp.com
# Optional: file | firestore (default: firestore when FIREBASE_PROJECT_ID is set), and which world document to use
# WORLD_STORE=firestore
# WORLD_ID=main
# WORLD_FILE=saves/world.json
