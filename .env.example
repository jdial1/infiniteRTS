# Server variables (set on the Cloud Run service; locally, all optional)

# Required in production: ID tokens are verified against this project, and the world is stored in its Firestore
FIREBASE_PROJECT_ID=infiniterts-6c5ab
# Origins allowed to open a socket from a browser (comma-separated). The Android app sends no Origin.
# ALLOWED_ORIGINS=
# file | firestore (default: firestore when FIREBASE_PROJECT_ID is set), and which world document to use
# WORLD_STORE=firestore
# WORLD_ID=main
# WORLD_FILE=saves/world.json
